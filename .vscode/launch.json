{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Hermes ACP Extension",
      "type": "extensionHost",
      "request": "launch",
      "preLaunchTask": "npm: watch",
      "env": {
        "ELECTRON_RUN_AS_NODE": null
      },
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"]
    }
  ]
}
