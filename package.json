{
  "name": "hermes-gateway",
  "displayName": "Hermes Gateway",
  "description": "Hermes Agent client for VS Code via the local Hermes Gateway",
  "version": "0.0.1",
  "publisher": "mixermsk",
  "license": "MIT",
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "hermesGateway.openChat",
        "title": "Hermes Gateway: Open Chat"
      }
    ],
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "hermes-gateway",
          "title": "Hermes",
          "icon": "resources/hermes.svg"
        }
      ]
    },
    "views": {
      "hermes-gateway": [
        {
          "id": "hermesGateway.chat",
          "name": "Chat",
          "type": "webview"
        }
      ]
    }
  },
  "scripts": {
    "build:webview": "node scripts/build-webview-assets.cjs",
    "compile": "npm run build:webview && webpack --mode development",
    "watch": "webpack --watch --mode development",
    "package": "npm run build:webview && webpack --mode production",
    "vsix": "npm run package && vsce package --no-dependencies --allow-missing-repository",
    "compile-tests": "node -e \"require('node:fs').rmSync('out/test', { recursive: true, force: true })\" && tsc -p tsconfig.test.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "npm run compile-tests && mocha out/test/unit/**/*.test.js --ui tdd",
    "lint": "eslint src --max-warnings 0",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "test": "node ./out/test/integration/runTest.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^9.0.0",
    "mocha": "^12.0.3",
    "ts-loader": "^9.5.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.0.0",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "marked": "^18.1.0"
  }
}
